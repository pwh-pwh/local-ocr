#!/usr/bin/env bash
# local-ocr 入口。准备引擎/模型后把 --format 原样交给引擎，stdout/stderr 直通。
set -euo pipefail

SKILL_DIR="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=lib.sh
source "$SKILL_DIR/scripts/lib.sh"
FORMAT="text"
TIER="tiny"
ROBUST=0
IMAGE=""

usage() {
  echo "用法: $0 [--tier tiny|small|medium] [--robust] [--format text|json] <image_or_url>" >&2
  exit 2
}

json_str() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\r'/\\r}
  s=${s//$'\t'/\\t}
  printf '"%s"' "$s"
}

json_err() {
  local error="$1"
  local hint="${2:-}"
  if [[ "$FORMAT" == json ]]; then
    if [[ -n "$hint" ]]; then
      printf '{"ok":false,"error":%s,"hint":%s}\n' "$(json_str "$error")" "$(json_str "$hint")"
    else
      printf '{"ok":false,"error":%s}\n' "$(json_str "$error")"
    fi
  else
    echo "error: $error${hint:+ ($hint)}" >&2
  fi
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --tier) TIER="${2:-}"; shift 2 ;;
    --robust) ROBUST=1; shift ;;
    --format|-f) FORMAT="${2:-}"; shift 2 ;;
    -h|--help) usage ;;
    --) shift; break ;;
    -*) echo "未知参数: $1" >&2; usage ;;
    *) IMAGE="$1"; shift ;;
  esac
done
[[ -z "$IMAGE" && $# -gt 0 ]] && IMAGE="$1"
[[ -z "$IMAGE" ]] && usage
case "$TIER" in
  tiny|small|medium) ;;
  *) json_err invalid_tier "--tier 只能是 tiny / small / medium" ;;
esac
case "$FORMAT" in
  text|json) ;;
  *) json_err invalid_format "--format 只能是 text / json" ;;
esac

find_engine() {
  if [[ -n "${LOCAL_OCR_BIN:-}" && ( -x "${LOCAL_OCR_BIN}" || -f "${LOCAL_OCR_BIN}" ) ]]; then
    echo "$LOCAL_OCR_BIN"
    return
  fi
  local cand
  while IFS= read -r cand; do
    if [[ -x "$cand" || -f "$cand" ]]; then
      echo "$cand"
      return
    fi
  done < <(engine_candidates "$SKILL_DIR")
  return 1
}

ENGINE="$(find_engine || true)"
if [[ -z "$ENGINE" ]]; then
  echo "local-ocr: 首次使用，正在准备引擎和模型（无需 Rust）..." >&2
  if ! bash "$SKILL_DIR/scripts/doctor.sh" >&2; then
    json_err engine_missing "bash scripts/doctor.sh"
  fi
  ENGINE="$(find_engine || true)"
fi
[[ -n "$ENGINE" ]] || json_err engine_missing "bash scripts/doctor.sh"

MODELS="$(default_models_dir)"
if ! models_ready "$MODELS" "$TIER"; then
  bash "$SKILL_DIR/scripts/download-models.sh" "$TIER" >&2 || json_err model_missing "bash scripts/download-models.sh $TIER"
fi

WORKDIR=""
cleanup() {
  if [[ -n "$WORKDIR" && -d "$WORKDIR" ]]; then
    find "$WORKDIR" -delete 2>/dev/null || true
  fi
}
trap cleanup EXIT

INPUT="$IMAGE"
if [[ "$IMAGE" == http://* || "$IMAGE" == https://* ]]; then
  WORKDIR="${TMPDIR:-/tmp}/local-ocr-$$"
  mkdir -p "$WORKDIR"
  INPUT="$WORKDIR/input"
  curl -fsSL --retry 2 -o "$INPUT" "$IMAGE" || json_err download_failed
elif [[ ! -f "$IMAGE" ]]; then
  json_err image_not_found "$IMAGE"
fi

CMD=("$ENGINE" "$INPUT" --tier "$TIER" --format "$FORMAT" --models-dir "$MODELS")
[[ "$ROBUST" -eq 1 ]] && CMD+=(--robust)
"${CMD[@]}"
